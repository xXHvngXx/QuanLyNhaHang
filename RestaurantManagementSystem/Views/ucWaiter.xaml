<UserControl x:Class="RestaurantManagementSystem.Views.ucWaiter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RestaurantManagementSystem.Converters"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <local:StatusToBoolConverter x:Key="StatusToBoolConverter"/>
        <local:StatusToTextConverter x:Key="StatusToTextConverter"/>
        <Style x:Key="waitercombostyle" TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>

                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="5,3,18,3" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"/>

                            <TextBlock x:Name="PlaceholderTextBlock" 
                                       Text="{TemplateBinding Tag}" 
                                       Foreground="#888888" 
                                       FontStyle="Italic"
                                       IsHitTestVisible="False" 
                                       Margin="5,3,18,3"
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       Visibility="Hidden"/>

                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="LightGray"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="BaseBorder" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2,0,2,0" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="txtPlaceholder" 
                                       Text="{TemplateBinding Tag}" 
                                       Foreground="#A4B0BE" 
                                       FontStyle="Italic"
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       IsHitTestVisible="False" 
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""/>
                                    <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="txtPlaceholder" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" CornerRadius="15" Padding="15" Margin="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ĐỊNH VỊ BÀN" FontSize="18" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TextBox Height="35" 
                             Style="{StaticResource PlaceholderTextBoxStyle}"
                             Tag="Tìm kiếm bàn..."
                             Text="{Binding SearchTableText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,0,30,0"
                             BorderBrush="#DFE6E9"
                             Background="#F8F9FA"/>
                    <TextBlock Foreground="#A4B0BE" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False"/>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,10,0,10">
                    <ListBox x:Name="icTables" 
                             ItemsSource="{Binding Tables}" 
                             SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="GridTable" Margin="5,35,5,10">
                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" x:Name="CanvasSelectedArrow">
                                        <TextBlock Text="▼" FontSize="20" FontWeight="Bold" Foreground="#F1C40F" HorizontalAlignment="Center">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="-7" Y="-25" x:Name="SelectedArrowTransform"/>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="TextBlock.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="SelectedArrowTransform"
                                                                             Storyboard.TargetProperty="Y"
                                                                             From="-25" To="-15" Duration="0:0:0.5" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                    </Canvas>

                                    <Border x:Name="TableContainer" CornerRadius="10" BorderThickness="3" BorderBrush="Transparent">
                                        <Grid Width="90" Height="90">
                                            <Border x:Name="InnerBorder" CornerRadius="8" Background="#00B894">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TableName}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                        <Setter TargetName="InnerBorder" Property="Background" Value="#FF7675"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="0">
                                        <Setter TargetName="InnerBorder" Property="Background" Value="#00B894"/>
                                    </DataTrigger>
                                    <Trigger SourceName="TableContainer" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TableContainer" Property="BorderBrush" Value="#2D3436"/>
                                        <Setter TargetName="InnerBorder" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="CanvasSelectedArrow" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="TableContainer" Property="BorderBrush" Value="#F1C40F"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="15" Margin="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="📍 Đang order cho: " FontSize="20" FontWeight="Bold" Foreground="#E84118"/>
                    <TextBlock Text="{Binding SelectedTable.TableName}" FontSize="20" FontWeight="Bold" Foreground="#E84118"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <StackPanel Margin="0,20,5,0">
                        <ComboBox Width="135" Height="35" 
                                  Style="{StaticResource waitercombostyle}"
                                  Tag="Chọn Danh Mục"
                                  ItemsSource="{Binding Categories}" 
                                  SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="CategoryID"
                                  DisplayMemberPath="CategoryName" />
                    </StackPanel>

                    <StackPanel Margin="0,20,5,0">
                        <Grid>
                            <TextBox Width="125" Height="35" 
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     Tag="Tìm món (Gõ chữ)"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="5,0,22,0"/>
                            <TextBlock Foreground="#A4B0BE" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,20,5,0">
                        <ComboBox Width="135" Height="35" 
                                  Style="{StaticResource waitercombostyle}"
                                  Tag="Chọn Món Ăn"
                                  ItemsSource="{Binding FilteredFoods}" 
                                  SelectedItem="{Binding SelectedFood, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="FoodName"/>
                    </StackPanel>

                    <StackPanel Margin="0,20,5,0">
                        <TextBox Width="45" Height="35" 
                                 Style="{StaticResource PlaceholderTextBoxStyle}"
                                 Tag="SL"
                                 Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Content="THÊM" Command="{Binding AddFoodCommand}" Width="55" Height="35" Margin="0,20,4,0" Background="#0984E3" Foreground="White" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="SỬA" Command="{Binding UpdateFoodCommand}" CommandParameter="{Binding SelectedItem, ElementName=dgOrderBill}" 
                            IsEnabled="{Binding SelectedItem.Status, ElementName=dgOrderBill, Converter={StaticResource StatusToBoolConverter}}"
                            Width="55" Height="35" Margin="0,20,4,0" Background="#F1C40F" Foreground="#2D3436" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="XÓA" Command="{Binding DeleteFoodCommand}" CommandParameter="{Binding SelectedItem, ElementName=dgOrderBill}"
                            IsEnabled="{Binding SelectedItem.Status, ElementName=dgOrderBill, Converter={StaticResource StatusToBoolConverter}}"
                            Width="55" Height="35" Margin="0,20,4,0" Background="#D63031" Foreground="White" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button Content="GỬI ĐƠN" 
                            Command="{Binding ConfirmOrderCommand}" 
                            Width="80" Height="35" Margin="4,20,4,0" 
                            Background="#27AE60" Foreground="White" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="🔄" Command="{Binding LoadDataCommand}" Width="40" Height="35" Margin="0,20,0,0" Background="#636E72" Foreground="White" FontSize="16">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <DataGrid x:Name="dgOrderBill" Grid.Row="2" 
                          ItemsSource="{Binding BillDetails}"
                          SelectedItem="{Binding SelectedBillDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Background="White" BorderThickness="1" BorderBrush="#DFE6E9"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F2F6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên món" Binding="{Binding FoodName}" Width="*"/>
                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="50"/>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="Trạng thái" Width="80" 
                                            Binding="{Binding Status, Converter={StaticResource StatusToTextConverter}}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>