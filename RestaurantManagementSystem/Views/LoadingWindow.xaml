<Window x:Class="RestaurantManagementSystem.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading..." 
        Height="350" Width="550"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Storyboard x:Key="MasterLoadingAnim">
            <DoubleAnimation Storyboard.TargetProperty="Width"
                             Storyboard.TargetName="ProgressRect"
                             From="0" To="310" Duration="0:0:2.0">
                <DoubleAnimation.EasingFunction>
                    <PowerEase Power="3" EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text" Storyboard.TargetName="TxtPercent">
                <DiscreteStringKeyFrame Value="0%" KeyTime="0:0:0" />
                <DiscreteStringKeyFrame Value="3%" KeyTime="0:0:0.1" />
                <DiscreteStringKeyFrame Value="7%" KeyTime="0:0:0.2" />
                <DiscreteStringKeyFrame Value="12%" KeyTime="0:0:0.3" />
                <DiscreteStringKeyFrame Value="16%" KeyTime="0:0:0.4" />
                <DiscreteStringKeyFrame Value="20%" KeyTime="0:0:0.5" />

                <DiscreteStringKeyFrame Value="25%" KeyTime="0:0:0.6" />
                <DiscreteStringKeyFrame Value="31%" KeyTime="0:0:0.7" />
                <DiscreteStringKeyFrame Value="38%" KeyTime="0:0:0.8" />
                <DiscreteStringKeyFrame Value="44%" KeyTime="0:0:0.9" />
                <DiscreteStringKeyFrame Value="50%" KeyTime="0:0:1.0" />
                <DiscreteStringKeyFrame Value="55%" KeyTime="0:0:1.1" />
                <DiscreteStringKeyFrame Value="60%" KeyTime="0:0:1.2" />

                <DiscreteStringKeyFrame Value="66%" KeyTime="0:0:1.3" />
                <DiscreteStringKeyFrame Value="72%" KeyTime="0:0:1.4" />
                <DiscreteStringKeyFrame Value="78%" KeyTime="0:0:1.5" />
                <DiscreteStringKeyFrame Value="83%" KeyTime="0:0:1.6" />
                <DiscreteStringKeyFrame Value="87%" KeyTime="0:0:1.7" />
                <DiscreteStringKeyFrame Value="90%" KeyTime="0:0:1.8" />

                <DiscreteStringKeyFrame Value="95%" KeyTime="0:0:1.9" />
                <DiscreteStringKeyFrame Value="100%" KeyTime="0:0:2.0" />
            </StringAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="LoadingBarGroup"
                             From="1" To="0" BeginTime="0:0:2.0" Duration="0:0:0.15"/>

            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="TxtInitializing"
                             From="1" To="0" BeginTime="0:0:2.0" Duration="0:0:0.15"/>

            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="SuccessMarkGrid"
                             From="0" To="1" BeginTime="0:0:2.0" Duration="0:0:0.2"/>

            <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" Storyboard.TargetName="SuccessMarkGrid"
                             From="0.4" To="1" BeginTime="0:0:2.0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.3" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" Storyboard.TargetName="SuccessMarkGrid"
                             From="0.4" To="1" BeginTime="0:0:2.0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.3" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="MainBorder"
                             From="1" To="0" BeginTime="0:0:3.6" Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource MasterLoadingAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border x:Name="MainBorder" Background="#FFFFFF" CornerRadius="16" Width="450" Height="220">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="1" Opacity="0.05" Color="#334155"/>
            </Border.Effect>

            <Grid>
                <StackPanel VerticalAlignment="Center">

                    <TextBlock FontSize="38" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,15">
                        <TextBlock.Foreground>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <GradientStop Color="#334155" Offset="0"/>
                                <GradientStop Color="#475569" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        RESTAURANT
                        <LineBreak/>
                        <Run Foreground="#475569" FontSize="14" FontWeight="SemiBold">MANAGEMENT SYSTEM</Run>
                    </TextBlock>

                    <Grid Height="65">

                        <StackPanel x:Name="LoadingBarGroup" Width="310" VerticalAlignment="Center" Opacity="1">
                            <TextBlock x:Name="TxtPercent" Text="0%" HorizontalAlignment="Center" 
                                       Foreground="#475569" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                            <Grid Height="6">
                                <Border Background="#F1F5F9" CornerRadius="3"/>
                                <Rectangle x:Name="ProgressRect" Width="0" HorizontalAlignment="Left" RadiusX="3" RadiusY="3">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#94A3B8" Offset="0"/>
                                            <GradientStop Color="#475569" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </StackPanel>

                        <Grid x:Name="SuccessMarkGrid" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
                            </Grid.RenderTransform>

                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#14B8A6" Offset="0"/>
                                        <GradientStop Color="#0F766E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M2,7 L6,11 L14,2" 
                                        Stroke="White" 
                                        StrokeThickness="2.5" 
                                        StrokeStartLineCap="Round" 
                                        StrokeEndLineCap="Round" 
                                        StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Grid>

                    </Grid>

                    <TextBlock x:Name="TxtInitializing"
                               Text="INITIALIZING RESOURCES..." 
                               HorizontalAlignment="Center" 
                               Margin="0,15,0,0" 
                               Foreground="#94A3B8" 
                               FontSize="9" 
                               FontWeight="Bold"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>