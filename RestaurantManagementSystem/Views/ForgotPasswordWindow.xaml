<Window x:Class="RestaurantManagementSystem.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khôi phục mật khẩu" Height="550" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        x:Name="wdForgotPassword">
    <Window.Resources>
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="20" BorderBrush="#0984E3" BorderThickness="1">
        <Grid Margin="30">
            <StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Width="25" Height="25" 
                        Background="Transparent" BorderThickness="0" Click="btnClose_Click" Margin="0,-10,0,10" Foreground="Gray"/>
                <TextBlock Text="KHÔI PHỤC MẬT KHẨU" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="Tên đăng nhập" Foreground="Gray" FontSize="12"/>
                <TextBox x:Name="txtUserName" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Tên hiển thị (xác thực)" Foreground="Gray" FontSize="12"/>
                <TextBox x:Name="txtDisplayName" Text="{Binding InputDisplayName, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Mật khẩu mới" Foreground="Gray" FontSize="12"/>
                <Grid Margin="0,5,0,15">
                    <PasswordBox x:Name="pwbNewPassword" Height="35" Padding="10,0,30,0" VerticalContentAlignment="Center"/>
                    <TextBox x:Name="txtNewPasswordVisible" Height="35" Padding="10,0,30,0" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                    <Button Content="👁" Style="{StaticResource EyeButtonStyle}" HorizontalAlignment="Right" Width="30" 
                            PreviewMouseDown="Eye_PreviewMouseDown" PreviewMouseUp="Eye_PreviewMouseUp" MouseLeave="Eye_MouseLeave"/>
                </Grid>

                <TextBlock Text="Nhập lại mật khẩu" Foreground="Gray" FontSize="12"/>
                <Grid Margin="0,5,0,20">
                    <PasswordBox x:Name="pwbConfirmPassword" Height="35" Padding="10,0,30,0" VerticalContentAlignment="Center"/>
                    <TextBox x:Name="txtConfirmPasswordVisible" Height="35" Padding="10,0,30,0" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                    <Button Content="👁" Style="{StaticResource EyeButtonStyle}" HorizontalAlignment="Right" Width="30" 
                            PreviewMouseDown="Eye_ConfirmMouseDown" PreviewMouseUp="Eye_ConfirmMouseUp" MouseLeave="Eye_ConfirmMouseLeave"/>
                </Grid>

                <Button Content="XÁC NHẬN ĐỔI" 
                        Height="45" Background="#0984E3" Foreground="White"
                        FontWeight="Bold" Cursor="Hand" 
                        Click="btnConfirm_Click" />
            </StackPanel>

            <Border x:Name="brdSuccess" Background="#27ae60" CornerRadius="20" 
                    Visibility="Collapsed" Opacity="0" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Padding="30,20" Panel.ZIndex="999">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔" Foreground="White" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="THÀNH CÔNG" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Đổi mật khẩu thành công!" Foreground="#e0e0e0" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="brdError" Background="#e74c3c" CornerRadius="20" 
                    Visibility="Collapsed" Opacity="0" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Padding="30,20" Panel.ZIndex="999">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Foreground="White" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="THẤT BẠI" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="txtErrorDetail" Text="Thông tin không hợp lệ!" Foreground="#f5f5f5" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>