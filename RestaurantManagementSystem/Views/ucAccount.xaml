<UserControl x:Class="RestaurantManagementSystem.Views.ucAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             Background="#F5F6FA">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="👥 QUẢN LÝ TÀI KHOẢN" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                    <TextBlock Text="Tên đăng nhập (UserName):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtUserName" 
                            Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{Binding IsUserNameReadOnly}"
                            Height="35" Padding="10,8" Margin="0,0,0,15"/>

                    <TextBlock Text="Tên hiển thị:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDisplayName" 
                            Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                            Height="35" Padding="10,8" Margin="0,0,0,15"/>

                    <TextBlock Text="Loại tài khoản:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>

                    <ComboBox x:Name="cbAccountType" 
                                SelectedValue="{Binding AccountType}" 
                                SelectedValuePath="Tag"
                                Height="35" Padding="10,8" Margin="0,0,0,25"
                                SelectedIndex="0"
                                VerticalContentAlignment="Center">
                        <ComboBoxItem Content="-- Loại tài khoản --" Tag="-99" IsEnabled="False"/>
                        <ComboBoxItem Content="Tài khoản đang đóng băng / Chờ xác minh" Tag="-1"/>
                        <ComboBoxItem Content="Quản trị viên (Directeur)" Tag="0"/>
                        <ComboBoxItem Content="Nhân viên phục vụ (Serveur)" Tag="1"/>
                        <ComboBoxItem Content="Nhân viên thu ngân (Caissier)" Tag="2"/>
                    </ComboBox>

                    <StackPanel Margin="0,0,0,15" Visibility="{Binding IsFormatStaff, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="🔒 Quyền thao tác chi tiết của Phục vụ:" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                        <CheckBox Content="Cho phép Sửa món (Đổi số lượng)" 
                                    IsChecked="{Binding CanEditFood, Mode=TwoWay}"
                                    FontSize="14" Margin="5,4,0,4" Foreground="#2C3E50"/>

                        <CheckBox Content="Cho phép Xóa món khỏi bàn ăn" 
                                    IsChecked="{Binding CanDeleteFood, Mode=TwoWay}"
                                    FontSize="14" Margin="5,4,0,4" Foreground="#2C3E50"/>

                        <CheckBox Content="Cho phép Gửi món (Xác nhận)" 
                                    IsChecked="{Binding CanSendFood, Mode=TwoWay}"
                                    FontSize="14" Margin="5,4,0,4" Foreground="#2C3E50"/>

                        <Button Content="⚡ Áp đặt quyền lực lên nút bấm" 
                                    Command="{Binding UpdateStaffPermissionCommand}"
                                    Background="#D35400" Foreground="White" FontWeight="Bold"
                                    Height="32" Margin="0,10,0,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15" Visibility="{Binding IsFormatCashier, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="🔒 Quyền thao tác của Thu ngân:" FontWeight="Bold" Foreground="#2C3E50" Margin="0,5,0,8"/>

                        <CheckBox Content="Cho phép In hóa đơn tạm (In thử)" 
                IsChecked="{Binding CanPrintDraft, Mode=TwoWay}"
                FontSize="13" Margin="5,3,0,3" Foreground="#2C3E50"/>

                        <CheckBox Content="Cho phép Thanh toán / Xuất hóa đơn" 
                IsChecked="{Binding CanCheckout, Mode=TwoWay}"
                FontSize="13" Margin="5,3,0,3" Foreground="#2C3E50"/>

                        <Button Content="⚡ Áp đặt quyền lực Thu ngân" 
                Command="{Binding UpdateCashierPermissionCommand}"
                Background="#2980B9" Foreground="White" FontWeight="Bold"
                Height="30" Margin="0,8,0,0" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <UniformGrid Columns="2" Rows="2" VerticalAlignment="Top" Margin="0,0,0,15">
                        <Button Command="{Binding AddCommand}" Content="➕ Thêm" Height="40" Margin="0,0,5,5" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Command="{Binding EditCommand}" Content="✏️ Sửa" Height="40" Margin="5,0,0,5" Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Command="{Binding DeleteCommand}" Content="🗑️ Xóa" Height="40" Margin="0,5,5,0" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Command="{Binding ClearCommand}" Content="🔄 Nhập lại" Height="40" Margin="5,5,0,0" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </UniformGrid>

                    <Button Command="{Binding ResetPasswordCommand}" Content="🔑 Đặt lại mật khẩu mặc định" Height="40" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                    <Separator Margin="0,15" Background="#BDC3C7"/>

                    <TextBlock Text="💾 HỆ THỐNG DỮ LIỆU" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="5" Background="#27AE60" Margin="0,0,5,0">
                            <Button Content="SAO LƯU (BACKUP)" 
                        Command="{Binding BackupCommand}"
                        Foreground="White" Background="Transparent" BorderThickness="0" 
                        Padding="5" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="5" Background="#E67E22" Margin="5,0,0,0">
                            <Button Content="PHỤC HỒI (RESTORE)" 
                        Command="{Binding RestoreCommand}"
                        Foreground="White" Background="Transparent" BorderThickness="0" 
                        Padding="5" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DANH SÁCH TÀI KHOẢN" FontWeight="Bold" Foreground="#34495E" Margin="5,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TextBox x:Name="txtSearch" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Padding="10,8" VerticalContentAlignment="Center"/>

                    <TextBlock Text="🔍 Tìm kiếm tài khoản..." 
                               Foreground="Gray" IsHitTestVisible="False" 
                               VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <DataGrid x:Name="dgAccount" Grid.Row="2" 
                          ItemsSource="{Binding AccountList}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single"
                          Background="White" RowHeight="35" ColumnHeaderHeight="40" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding UserName}" Width="120"/>
                        <DataGridTextColumn Header="Tên Hiển Thị" Binding="{Binding DisplayName}" Width="*"/>

                        <DataGridTemplateColumn Header="Quyền" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="0">
                                                        <Setter Property="Text" Value="Quản trị"/>
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Role}" Value="1">
                                                        <Setter Property="Text" Value="Phục vụ"/>
                                                        <Setter Property="Foreground" Value="#2C3E50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="2">
                                                        <Setter Property="Text" Value="Thu ngân"/>
                                                        <Setter Property="Foreground" Value="#2980B9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="-1">
                                                        <Setter Property="Text" Value="None"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Role}" Value="11">
                                                        <Setter Property="Text" Value="Phục vụ (Hạn chế)"/>
                                                        <Setter Property="Foreground" Value="#E67E22"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="12">
                                                        <Setter Property="Text" Value="Phục vụ (Hạn chế)"/>
                                                        <Setter Property="Foreground" Value="#E67E22"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="13">
                                                        <Setter Property="Text" Value="Phục vụ (Hạn chế)"/>
                                                        <Setter Property="Foreground" Value="#E67E22"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="14">
                                                        <Setter Property="Text" Value="Phục vụ (Hạn chế)"/>
                                                        <Setter Property="Foreground" Value="#E67E22"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="15">
                                                        <Setter Property="Text" Value="Phục vụ (Hạn chế)"/>
                                                        <Setter Property="Foreground" Value="#E67E22"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Role}" Value="21">
                                                        <Setter Property="Text" Value="Thu ngân (Hạn chế)"/>
                                                        <Setter Property="Foreground" Value="#D35400"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="22">
                                                        <Setter Property="Text" Value="Thu ngân (Hạn chế)"/>
                                                        <Setter Property="Foreground" Value="#D35400"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="23">
                                                        <Setter Property="Text" Value="Thu ngân (Hạn chế)"/>
                                                        <Setter Property="Foreground" Value="#D35400"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>